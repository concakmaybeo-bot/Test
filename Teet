-- Script Autoplayer Basically FNF - Hold Note & Zero-Miss Fixed Version

local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local AutoplayerEnabled = true

local KeyMapping = {
    ["Arrow1"] = Enum.KeyCode.A,
    ["Arrow2"] = Enum.KeyCode.S,
    ["Arrow3"] = Enum.KeyCode.W,
    ["Arrow4"] = Enum.KeyCode.D
}

local currentSide = "KeySync1"
local function getMyKeySync()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    local main = playerGui:FindFirstChild("Main")
    if not main then return nil end
    local matchFrame = main:FindFirstChild("MatchFrame")
    if not matchFrame then return nil end
    return matchFrame:FindFirstChild(currentSide)
end

print("Script loaded by CHIẾN ĐO - Hold Note Fixed Mode")

local Connections = {}
local activeHolds = {
    [Enum.KeyCode.A] = false,
    [Enum.KeyCode.S] = false,
    [Enum.KeyCode.W] = false,
    [Enum.KeyCode.D] = false
}

local function startFixedThread(arrowName, keyCode)
    if Connections[arrowName] then
        Connections[arrowName]:Disconnect()
    end
    
    Connections[arrowName] = RunService.RenderStepped:Connect(function()
        if not AutoplayerEnabled then return end
        
        local MyKeySync = getMyKeySync()
        if MyKeySync then
            local arrowBase = MyKeySync:FindFirstChild(arrowName)
            if arrowBase then
                local notesFolder = arrowBase:FindFirstChild("Notes")
                if notesFolder then
                    local baseY = arrowBase.AbsolutePosition.Y
                    local holdingAny = false
                    
                    for _, note in ipairs(notesFolder:GetChildren()) do
                        if note:IsA("ImageLabel") or note:IsA("Frame") then
                            local noteY = note.AbsolutePosition.Y
                            local sizeY = note.AbsoluteSize.Y
                            
                            -- Check if note is a hold note tail/body or a standard note
                            local isHold = note:FindFirstChild("Tail") or note:FindFirstChild("HoldBar") or sizeY > 40
                            
                            if isHold then
                                -- Hold note logic: Press when it reaches, keep holding until it passes the tail
                                local tailY = noteY + sizeY
                                if noteY <= baseY + 15 and tailY >= baseY - 10 then
                                    holdingAny = true
                                    if not activeHolds[keyCode] then
                                        activeHolds[keyCode] = true
                                        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                                    end
                                end
                            else
                                -- Standard note logic with wider catch zone to eliminate misses
                                if not note:GetAttribute("Processed") and math.abs(noteY - baseY) <= 25 then
                                    note:SetAttribute("Processed", true)
                                    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                                    task.spawn(function()
                                        task.wait(0.03)
                                        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
                                        note:Destroy()
                                    end)
                                end
                            end
                        end
                    end
                    
                    -- Release key if no active hold note is currently covering the receptor
                    if activeHolds[keyCode] and not holdingAny then
                        activeHolds[keyCode] = false
                        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
                    end
                end
            end
        end
    end)
end

startFixedThread("Arrow1", KeyMapping["Arrow1"])
startFixedThread("Arrow2", KeyMapping["Arrow2"])
startFixedThread("Arrow3", KeyMapping["Arrow3"])
startFixedThread("Arrow4", KeyMapping["Arrow4"])


