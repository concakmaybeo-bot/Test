-- FNF Autoplayer Dual Mode (Ultimate Speed <-> Lite) + Side Selection + Fix Lag (Fixed Version)

local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

local function makeDraggable(guiObject)
    local dragging, dragInput, dragStart, startPos

    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            guiObject.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

-- CẤU HÌNH CHUNG
local AutoplayerEnabled = true
local HitThreshold = 45 -- Mở rộng phạm vi quét để bắt nốt chuẩn xác hơn
local KeyMapping = {
    ["Arrow1"] = Enum.KeyCode.A,
    ["Arrow2"] = Enum.KeyCode.S,
    ["Arrow3"] = Enum.KeyCode.W,
    ["Arrow4"] = Enum.KeyCode.D
}

local currentSide = "KeySync1"
local currentMode = "Ultimate" -- "Ultimate" hoặc "Lite"

local function getMyKeySync()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    local main = playerGui:FindFirstChild("Main")
    if not main then return nil end
    local matchFrame = main:FindFirstChild("MatchFrame")
    if not matchFrame then return nil end
    return matchFrame:FindFirstChild(currentSide)
end

local Connections = {}
local activeHoldNotes = {}

-- THUẬT TOÁN TỐI ƯU CHO CẢ 2 CHẾ ĐỘ
local function startEngine(arrowName, keyCode)
    if Connections[arrowName] then
        Connections[arrowName]:Disconnect()
    end
    
    activeHoldNotes[arrowName] = false
    
    Connections[arrowName] = RunService.RenderStepped:Connect(function()
        if not AutoplayerEnabled then return end
        
        local MyKeySync = getMyKeySync()
        if MyKeySync then
            local arrowBase = MyKeySync:FindFirstChild(arrowName)
            if arrowBase then
                -- Tìm thư mục chứa nốt linh hoạt hơn (hỗ trợ cả Notes lẫn các tên khác)
                local notesFolder = arrowBase:FindFirstChild("Notes") or arrowBase
                local baseY = arrowBase.AbsolutePosition.Y
                
                -- 1. CHẾ ĐỘ ULTIMATE SPEED
                if currentMode == "Ultimate" then
                    for _, note in ipairs(notesFolder:GetChildren()) do
                        if (note:IsA("ImageLabel") or note:IsA("Frame")) and note.Name ~= "Receptor" and not note:GetAttribute("Processed") then
                            local noteY = note.AbsolutePosition.Y
                            local diff = math.abs(noteY - baseY)
                            
                            if diff <= HitThreshold then
                                note:SetAttribute("Processed", true)
                                VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
                                VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                                
                                task.spawn(function()
                                    task.wait(0.05)
                                    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
                                    pcall(function() note:Destroy() end)
                                end)
                            end
                        end
                    end
                    
                -- 2. CHẾ ĐỘ LITE (Tối ưu giữ nốt Hold Note)
                elseif currentMode == "Lite" then
                    local isHoldingNow = false
                    for _, note in ipairs(notesFolder:GetChildren()) do
                        if note:IsA("GuiObject") and note.Name ~= "Receptor" then
                            local noteY = note.AbsolutePosition.Y
                            local noteSizeY = note.AbsoluteSize.Y
                            local noteBottom = noteY + noteSizeY
                            
                            local isLongNote = noteSizeY > 35 or note:FindFirstChild("Tail") or note:FindFirstChild("HoldBar") or note:FindFirstChild("Body") or note:FindFirstChild("Hold")
                            
                            if isLongNote then
                                if noteY <= baseY + 35 and noteBottom >= baseY - 20 then
                                    isHoldingNow = true
                                end
                            else
                                if not note:GetAttribute("Processed") and math.abs(noteY - baseY) <= HitThreshold then
                                    note:SetAttribute("Processed", true)
                                    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                                    task.spawn(function()
                                        task.wait(0.05)
                                        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
                                        pcall(function() note:Destroy() end)
                                    end)
                                end
                            end
                        end
                    end
                    
                    if isHoldingNow ~= activeHoldNotes[arrowName] then
                        activeHoldNotes[arrowName] = isHoldingNow
                        VirtualInputManager:SendKeyEvent(isHoldingNow, keyCode, false, game)
                    end
                end
            end
        end
    end)
end

startEngine("Arrow1", KeyMapping["Arrow1"])
startEngine("Arrow2", KeyMapping["Arrow2"])
startEngine("Arrow3", KeyMapping["Arrow3"])
startEngine("Arrow4", KeyMapping["Arrow4"])


