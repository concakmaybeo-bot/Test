-- Script Autoplayer Basically FNF - Absolute Zero-Miss Ultra-Lite Version
-- Direct position locking & instant note state cleanup

local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ABSOLUTE ZERO-MISS CONFIGURATION
local AutoplayerEnabled = true

local KeyMapping = {
    ["Arrow1"] = Enum.KeyCode.A,
    ["Arrow2"] = Enum.KeyCode.S,
    ["Arrow3"] = Enum.KeyCode.W,
    ["Arrow4"] = Enum.KeyCode.D
}

local currentSide = "KeySync1"
local function getMyKeySync()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    local main = playerGui:FindFirstChild("Main")
    if not main then return nil end
    local matchFrame = main:FindFirstChild("MatchFrame")
    if not matchFrame then return nil end
    return matchFrame:FindFirstChild(currentSide)
end

print("Script loaded by CHIẾN ĐO - Zero-Miss Lite Mode Activated")

local Connections = {}

local function startZeroMissThread(arrowName, keyCode)
    if Connections[arrowName] then
        Connections[arrowName]:Disconnect()
    end
    
    Connections[arrowName] = RunService.RenderStepped:Connect(function()
        if not AutoplayerEnabled then return end
        
        local MyKeySync = getMyKeySync()
        if MyKeySync then
            local arrowBase = MyKeySync:FindFirstChild(arrowName)
            if arrowBase then
                local notesFolder = arrowBase:FindFirstChild("Notes")
                if notesFolder then
                    local baseY = arrowBase.AbsolutePosition.Y
                    
                    for _, note in ipairs(notesFolder:GetChildren()) do
                        if (note:IsA("ImageLabel") or note:IsA("Frame")) and not note:GetAttribute("Processed") then
                            local noteY = note.AbsolutePosition.Y
                            
                            -- Zero-Miss Logic: Intercepts the moment the note crosses or reaches the receptor line
                            if noteY <= baseY + 10 then
                                note:SetAttribute("Processed", true)
                                
                                -- Immediate keystroke injection with zero lag window
                                VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                                task.spawn(function()
                                    task.wait(0.02)
                                    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
                                    note:Destroy()
                                end)
                            end
                        end
                    end
                end
            end
        end
    end)
end

startZeroMissThread("Arrow1", KeyMapping["Arrow1"])
startZeroMissThread("Arrow2", KeyMapping["Arrow2"])
startZeroMissThread("Arrow3", KeyMapping["Arrow3"])
startZeroMissThread("Arrow4", KeyMapping["Arrow4"])


