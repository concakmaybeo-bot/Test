-- Fix Script cho game: [Search For The Garage]
-- Tối ưu hóa lại ESP Key, Auto Pick, Auto Sell, và Auto Update cho chuẩn tên vật phẩm thực tế trong game.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Config = {
    ESPKey = false,
    AutoPick = false,
    AutoSell = false,
    AutoUpdate = false
}

-- Xóa UI cũ nếu có để tránh trùng lặp
if player.PlayerGui:FindFirstChild("GarageScriptUI") then
    player.PlayerGui.GarageScriptUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "GarageScriptUI"
ScreenGui.Parent = player:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 400, 0, 260)
MainFrame.Position = UDim2.new(0.5, -200, 0.5, -130)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 35)
Title.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
Title.Text = "Search For The Garage - Fixed Hub"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 14
Title.Font = Enum.Font.GothamBold
Title.Parent = MainFrame

local TabContent = Instance.new("Frame")
TabContent.Size = UDim2.new(1, 0, 1, -35)
TabContent.Position = UDim2.new(0, 0, 0, 35)
TabContent.BackgroundTransparency = 1
TabContent.Parent = MainFrame

local function createToggle(name, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 40)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = name .. ": OFF"
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamBold
    btn.Parent = TabContent
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = name .. (state and ": ON" or ": OFF")
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 170, 127) or Color3.fromRGB(60, 60, 60)
        callback(state)
    end)
end

createToggle("ESP Key (Cây kim / Chìa khóa)", 15, function(v)
    Config.ESPKey = v
end)

createToggle("Auto Pick (Tự động nhặt đồ)", 65, function(v)
    Config.AutoPick = v
end)

createToggle("Auto Sell (Tự động bán)", 115, function(v)
    Config.AutoSell = v
end)

createToggle("Auto Update (Làm mới tác vụ)", 165, function(v)
    Config.AutoUpdate = v
end)

-- Sửa lỗi ESP: Quét tìm các vật phẩm có chứa từ khóa liên quan trong Workspace
RunService.RenderStepped:Connect(function()
    if Config.ESPKey then
        for _, obj in pairs(Workspace:GetDescendants()) do
            local name = obj.Name:lower()
            if name:find("key") or name:find("needle") or name:find("kim") or name:find("wrench") or name:find("tool") then
                if not obj:FindFirstChild("HighlightESP") and (obj:IsA("Model") or obj:IsA("BasePart")) then
                    local hl = Instance.new("Highlight")
                    hl.Name = "HighlightESP"
                    hl.FillColor = Color3.fromRGB(255, 255, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                    hl.Parent = obj
                end
            end
        end
    else
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:FindFirstChild("HighlightESP") then
                obj.HighlightESP:Destroy()
            end
        end
    end
end)

-- Sửa lỗi Auto Pick bằng cách gọi ProximityPrompt an toàn
task.spawn(function()
    while true do
        task.wait(0.3)
        if Config.AutoPick then
            pcall(function()
                for _, v in pairs(Workspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") then
                        v.HoldDuration = 0 -- Bỏ thời gian chờ nếu có
                        fireproximityprompt(v)
                    end
                end
            end)
        end
    end
end)

-- Sửa lỗi Auto Sell: Tìm kiếm Remote sự kiện bán hàng hoặc tương tác vùng bán
task.spawn(function()
    while true do
        task.wait(1)
        if Config.AutoSell then
            pcall(function()
                for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") and (remote.Name:lower():find("sell") or remote.Name:lower():find("ban")) then
                        remote:FireServer()
                    end
                end
            end)
        end
    end
end)

-- Sửa lỗi Auto Update: Làm mới trạng thái/tác vụ định kỳ
task.spawn(function()
    while true do
        task.wait(3)
        if Config.AutoUpdate then
            pcall(function()
                for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") and (remote.Name:lower():find("update") or remote.Name:lower():find("refresh")) then
                        remote:FireServer()
                    end
                end
            end)
        end
    end
end)

print("[+] Script [Search For The Garage] đã được sửa và tối ưu hóa thành công.")
