-- Hệ thống Lưu/Xóa ID nhạc qua file JSON
local fileName = "BoomboxSavedIDs.json"

local function loadSavedIDs()
    if writefile and readfile and isfile then
        if isfile(fileName) then
            local success, data = pcall(function()
                return HttpService:JSONDecode(readfile(fileName))
            end)
            if success and type(data) == "table" then
                return data
            end
        end
    end
    return {}
end

local function saveID(id)
    if writefile and HttpService then
        local currentList = loadSavedIDs()
        for _, v in ipairs(currentList) do
            if v == id then return end
        end
        table.insert(currentList, id)
        pcall(function()
            writefile(fileName, HttpService:JSONEncode(currentList))
        end)
    end
end

local function removeID(idToRemove)
    if writefile and HttpService then
        local currentList = loadSavedIDs()
        local newList = {}
        for _, v in ipairs(currentList) do
            if v ~= idToRemove then
                table.insert(newList, v)
            end
        end
        pcall(function()
            writefile(fileName, HttpService:JSONEncode(newList))
        end)
    end
end

-- Hàm hỗ trợ kéo thả (Draggable) cho cả Mobile lẫn PC
local function makeDraggable(guiObject)
    local dragging, dragInput, dragStart, startPos

    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            guiObject.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

