    sound = Instance.new("Sound")
    sound.Name = "BoomboxMusic"
    sound.Volume = 2
    sound.RollOffMaxDistance = 150
    sound.RollOffMinDistance = 10
    sound.Parent = handle
end

-- File Save/Load System
local fileName = "BoomboxSavedIDs.json"

local function loadSavedIDs()
    if writefile and readfile and isfile then
        if isfile(fileName) then
            local success, data = pcall(function()
                return HttpService:JSONDecode(readfile(fileName))
            end)
            if success and type(data) == "table" then
                return data
            end
        end
    end
    return {}
end

local function saveID(id)
    if writefile and HttpService then
        local currentList = loadSavedIDs()
        for _, v in ipairs(currentList) do
            if v == id then return end
        end
        table.insert(currentList, id)
        pcall(function()
            writefile(fileName, HttpService:JSONEncode(currentList))
        end)
    end
end

