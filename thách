-- Fix lỗi không phát nhạc: Tự động tạo Sound trực tiếp trên Client gắn vào Character nếu chưa có
local handle = character:FindFirstChild("HumanoidRootPart")
local sound = handle:FindFirstChild("BoomboxMusic")
